{
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": ["bun", "vscode"],
    "verbatimModuleSyntax": true
  },
  "include": ["build.ts", "publish.ts", "verifyPackage.ts", "src/**/*.ts", "tests/**/*.ts"]
}
