{
	"compilerOptions": {
		"lib": ["DOM", "ES2022"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"noEmit": true,
		"skipLibCheck": true,
		"strict": true,
		"target": "ES2022",
		"types": ["bun"],
		"verbatimModuleSyntax": true
	},
	"include": ["src/anomalies/**/*.ts", "tests/anomalies.test.ts",
		"tests/anomaly.if-consistency.test.ts",
		"tests/anomaly.incomplete-edits.test.ts",
		"tests/anomaly.transactions.test.ts",
		"tests/anomaly.valid-algorithm.test.ts"]
}
