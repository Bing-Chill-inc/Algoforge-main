{
  "name": "algoforge-obsidian",
  "version": "1.0.8",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run build.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests",
    "check": "bun run typecheck && bun run build && bun run test",
    "package": "bun run build && cd dist && zip -q ../algoforge-obsidian.zip main.js manifest.json styles.css",
    "release:stage": "bun run scripts/prepare-release.ts"
  },
  "devDependencies": {
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.6",
    "@types/bun": "^1.3.3",
    "obsidian": "^1.8.7",
    "typescript": "^7.0.2"
  }
}
